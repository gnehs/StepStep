# Copy to .env.local and replace these placeholders with private values.
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-secret"
INVITE_CODE="replace-with-a-private-invite-code"

# Optional when deploying WebAuthn or using a custom database path.
# WEBAUTHN_ORIGIN="https://example.com"
# SQLITE_PATH="/path/to/private/database.sqlite"
